page {
  background: #f6f0e5;
  color: #261d13;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Microsoft YaHei", sans-serif;
}

.container {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
}

.hero {
  padding: 34rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #23170c 0%, #6b461c 55%, #c6923d 100%);
  color: #fff8e8;
  box-shadow: 0 18rpx 45rpx rgba(85, 54, 18, 0.24);
}

.hero-title {
  font-size: 42rpx;
  font-weight: 700;
}

.hero-subtitle {
  margin-top: 12rpx;
  color: rgba(255, 248, 232, 0.78);
  font-size: 24rpx;
}

.card {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 28rpx;
  background: #fffaf1;
  box-shadow: 0 12rpx 30rpx rgba(86, 62, 33, 0.09);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #2e2116;
}

.muted {
  color: #8a7860;
  font-size: 24rpx;
}

.metric-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
  margin-top: 22rpx;
}

.metric {
  width: calc(50% - 9rpx);
  padding: 22rpx;
  border-radius: 22rpx;
  background: #f3ead9;
  box-sizing: border-box;
}

.metric-label {
  color: #806d55;
  font-size: 23rpx;
}

.metric-value {
  margin-top: 8rpx;
  font-size: 36rpx;
  font-weight: 800;
  color: #2e2116;
}

.primary-btn {
  margin-top: 24rpx;
  border-radius: 999rpx;
  background: linear-gradient(135deg, #d8a64d 0%, #8e5c21 100%);
  color: #fff;
  font-weight: 700;
}

.secondary-btn {
  margin-top: 18rpx;
  border-radius: 999rpx;
  background: #efe3ce;
  color: #5f421f;
  font-weight: 700;
}

.form-row {
  margin-top: 22rpx;
}

.label {
  display: block;
  margin-bottom: 12rpx;
  color: #6f5e49;
  font-size: 24rpx;
}

.input {
  height: 88rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #f3ead9;
  color: #2e2116;
  box-sizing: border-box;
}

.day-list {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 22rpx;
}

.day-pill {
  width: calc((100% - 60rpx) / 7);
  padding: 14rpx 0;
  border-radius: 16rpx;
  text-align: center;
  background: #f3ead9;
  color: #6f5e49;
  font-size: 22rpx;
  box-sizing: border-box;
}

.day-pill.active {
  background: #ba7d29;
  color: #fff;
}

.report-box {
  margin-top: 22rpx;
  padding: 24rpx;
  border-radius: 22rpx;
  background: #2a2118;
  color: #fff8e8;
  line-height: 1.8;
  font-size: 26rpx;
  white-space: pre-wrap;
}
